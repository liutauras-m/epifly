# epifly environment. Two kinds of variables:
#  1. Project variables: set these on the ConusAI Cloud project (scoped to the environment).
#  2. Linked-service variables: ConusAI Cloud injects them from the linked managed services;
#     set them here only for local runs with docker-compose.local.yml.
# `scripts/generate-env.sh > .env` fills in every secret for a local run.
# Full table: docs/deploy-conusai-cloud.md.

# ── 1. Project variables ──────────────────────────────────────────────────────
APP_DOMAIN=
ANTHROPIC_API_KEY=
# 32+ random bytes each, base64
PLATFORM_ADMIN_TOKEN=
RUSTFS_IAM_ENC_KEY=
AUTH_SESSION_KEY=
# Zitadel v4: masterkey exactly 32 characters; the admin is the first-instance human user
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_USERNAME=
ZITADEL_ADMIN_PASSWORD=
# Set after Zitadel's first start: project id (token audience) and the web app's client id
ZITADEL_AUDIENCE=
ZITADEL_WEB_CLIENT_ID=
# Lago
LAGO_SECRET_KEY_BASE=
LAGO_ENCRYPTION_PRIMARY_KEY=
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
# base64 of an RSA private key PEM
LAGO_RSA_PRIVATE_KEY=
# Set after Lago's first start (Lago → Developers)
LAGO_API_KEY=
LAGO_WEBHOOK_SECRET=
# ConusAI Cloud's OTLP base, e.g. https://stage.cloud.conusai.com/otel (empty = no telemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── 2. Linked-service variables (local runs only) ─────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=epifly
POSTGRES_PASSWORD=
POSTGRES_URL=
REDIS_URL=redis://redis:6379/0
QDRANT_GRPC_URL=http://qdrant:6334
S3_BUCKET=epifly
AWS_ENDPOINT_URL=http://rustfs:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CONUSAI_API_TOKEN=
QDRANT_API_KEY=
